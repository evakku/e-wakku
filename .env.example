# Supabase Configuration
# Required for database connection, authentication, and file storage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Service Role Key (Required for admin creation / user management)
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client-side code.
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Site URL (used for SEO, OpenGraph metadata, and sitemap generation)
NEXT_PUBLIC_SITE_URL=https://e-wakku.vercel.app/
